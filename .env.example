# =============================================================================
# AI Job Agent — Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# ---- Firecrawl (Wellfound scraper) ----------------------------------------
# Required for Wellfound. Without this key the Wellfound scraper is skipped.
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ---- Search defaults -------------------------------------------------------
SEARCH_KEYWORDS=python developer,data engineer
JOB_TITLES=Senior Python Developer,Software Engineer,Data Engineer
LOCATIONS=bangalore,remote
COUNTRY_FILTER=India
EXPERIENCE_LEVEL=mid-level,senior

# ---- Rate limiting ---------------------------------------------------------
REQUEST_DELAY=2          # seconds between HTTP requests (float, 0–120)
MAX_RETRIES=3            # max retry attempts per request (int, 1–10)
TIMEOUT=30               # HTTP timeout in seconds (int, 5–300)
BROWSER_TIMEOUT=30       # Playwright/UC page-load timeout in seconds (int, 5–300)

# ---- Naukri credentials ----------------------------------------------------
# These are internal Naukri API headers. Rotate via this file when Naukri
# invalidates them — never hardcode them in source code.
NAUKRI_CLIENT_ID=d3Wh4DeBn0q20
NAUKRI_APP_ID=109
NAUKRI_SYSTEM_ID=109

# ---- RemoteOK --------------------------------------------------------------
REMOTEOK_API_URL=https://remoteok.com/api

# ---- Wellfound -------------------------------------------------------------
WELLFOUND_BASE_URL=https://wellfound.com

# ---- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FILE=logs/job_agent.log

# ---- Storage ---------------------------------------------------------------
DATA_DIR=data
CSV_FILENAME_PATTERN=jobs_{date}.csv
