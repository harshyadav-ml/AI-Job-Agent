# Firecrawl API Configuration
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Search Configuration
SEARCH_KEYWORDS=python,developer,software engineer
JOB_TITLES=Senior Python Developer,Software Engineer,Full Stack Developer

# Location Filters
LOCATIONS=india,bengaluru,bangalore,hyderabad,pune,delhi,noida,gurgaon,mumbai,remote worldwide,anywhere
COUNTRY_FILTER=India

# Experience Level
EXPERIENCE_LEVEL=mid-level,senior

# Rate Limiting Configuration
REQUEST_DELAY=2  # seconds between requests
MAX_RETRIES=3
TIMEOUT=30  # seconds
BROWSER_TIMEOUT=30  # seconds

# Naukri Configuration
NAUKRI_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36

# RemoteOK Configuration
REMOTEOK_API_URL=https://remoteok.com/api

# Wellfound Configuration
WELLFOUND_BASE_URL=https://wellfound.com

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/job_agent.log

# Data Storage Configuration
DATA_DIR=data
CSV_FILENAME_PATTERN=jobs_{date}.csv